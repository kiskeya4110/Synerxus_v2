# ===========================================
# Environment Variables for Volunteer Platform
# ===========================================
# Copy this file to .env and fill in the values
# For Replit: Add these in the "Secrets" tab

# ===== DATABASE =====
# Use a non-production connection string from your secrets manager
DATABASE_URL=postgresql://username:password@db-host:5432/database_name?sslmode=require

# ===== SENTRY ERROR TRACKING =====
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# Format: https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=

# Enable Sentry in development (optional, default: only production)
# SENTRY_ENABLED=true

# ===== UPTIME MONITORING =====
# No configuration needed - endpoints are automatic
# Ping endpoint: /api/ping
# Status endpoint: /api/status

# ===== BACKUPS =====
# Backup output directory (default: ./backups)
# BACKUP_DIR=./backups

# Backup format: json, sql, csv (default: json)
# BACKUP_FORMAT=json

# Enable compression (default: false)
# BACKUP_COMPRESS=true

# Days to keep old backups (default: 7)
# BACKUP_RETENTION_DAYS=7

# ===== FEATURE FLAGS =====
# AIU (Attributable Impact Units) Display
# Set to 'true' to show AIU metrics to users
# Set to 'false' for Shadow Mode (calculations run, UI hidden)
# Default: false (Shadow Mode for pilot)
# TODO (Post-Pilot): Enable AIU display once marketing materials are ready
NEXT_PUBLIC_ENABLE_AIU_DISPLAY=false

# ===== EMAIL (SMTP) =====
# Generate a provider-specific app password or SMTP credential
# Never commit real credentials — use your secrets manager
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@your-app.domain.com

# ===== SECURITY =====
# Required in production — generate with:
#   openssl rand -hex 64
JWT_SECRET=replace_with_64_byte_random_hex
# Must be independent from JWT_SECRET — generate separately
REFRESH_TOKEN_SECRET=replace_with_independent_64_byte_random_hex
# Comma-separated list of allowed CORS origins (required in production)
CORS_WHITELIST=https://your-app.domain.com
# Full app origin URL — used to lock CSP WebSocket directive to your domain
APP_ORIGIN=https://your-app.domain.com

# ===== FIREBASE CLIENT (required for frontend auth — Vite exposes VITE_* vars to the browser) =====
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ===== FIREBASE ADMIN (required for production auth) =====
# Get these from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key with literal \n newlines (no actual line breaks)
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace_with_private_key_contents\n-----END PRIVATE KEY-----

# ===== TWILIO SMS (optional — enables SMS fallback verification) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===== OPTIONAL =====
# NODE_ENV=production
# PORT=5000
# RATE_LIMIT_MAX=300
# IMPACT_TEXT_VERIFICATION_AI_ENABLED=false
# IMPACT_TEXT_VERIFICATION_AI_MODEL=gpt-4o-mini
