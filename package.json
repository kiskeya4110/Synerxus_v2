  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "dev:clean": "pkill -f 'tsx server' 2>/dev/null; lsof -ti:5000 | xargs kill -9 2>/dev/null; sleep 1; npm run dev",
    "kill-port": "pkill -f 'tsx server' 2>/dev/null; lsof -ti:5000 | xargs kill -9 2>/dev/null; echo 'Port 5000 cleared'",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:cluster": "vite build && esbuild server/index-cluster.ts server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:production": "npm run build:cluster",
    "start": "NODE_OPTIONS='--max-old-space-size=1024' NODE_ENV=production node dist/index.js",
    "start:cluster": "NODE_OPTIONS='--max-old-space-size=1024' NODE_ENV=production node dist/index-cluster.js",
    "start:production": "NODE_OPTIONS='--max-old-space-size=1024' NODE_ENV=production CLUSTER_MODE=true node dist/index-cluster.js",
    "check": "tsc",
    "db:push": "npx drizzle-kit push",
    "synerxus": "./start-synerxus.sh",
    "seed": "tsx dummy/seed-data.ts",
    "seed:bulk": "tsx dummy/seed-bulk.ts",
    "seed:gfa": "tsx dummy/seed-gfa.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:python": "cd python_backend && if [ -x .venv/bin/pytest ]; then .venv/bin/pytest test_main.py -v; else pytest test_main.py -v; fi",
    "test:load": "npx autocannon -c 1000 -d 20 http://localhost:5000/api/users",
    "backup": "tsx scripts/backup-database.ts",
    "backup:json": "BACKUP_FORMAT=json tsx scripts/backup-database.ts",
    "backup:compressed": "BACKUP_FORMAT=json BACKUP_COMPRESS=true tsx scripts/backup-database.ts",
    "test:sentry": "tsx scripts/test-sentry.ts"
  },
