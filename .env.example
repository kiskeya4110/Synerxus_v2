# ===========================================
# Environment Variables for Volunteer Platform
# ===========================================
# Copy this file to .env and fill in the values
# For Replit: Add these in the "Secrets" tab

# ===== DATABASE =====
DATABASE_URL=postgresql://neondb_owner:npg_PjTzc61iUvYd@ep-wild-leaf-afikttq9.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require

# ===== SENTRY ERROR TRACKING =====
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# Format: https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=

# Enable Sentry in development (optional, default: only production)
# SENTRY_ENABLED=true

# ===== UPTIME MONITORING =====
# No configuration needed - endpoints are automatic
# Ping endpoint: /api/ping
# Status endpoint: /api/status

# ===== BACKUPS =====
# Backup output directory (default: ./backups)
# BACKUP_DIR=./backups

# Backup format: json, sql, csv (default: json)
# BACKUP_FORMAT=json

# Enable compression (default: false)
# BACKUP_COMPRESS=true

# Days to keep old backups (default: 7)
# BACKUP_RETENTION_DAYS=7

# ===== FEATURE FLAGS =====
# AIU (Attributable Impact Units) Display
# Set to 'true' to show AIU metrics to users
# Set to 'false' for Shadow Mode (calculations run, UI hidden)
# Default: false (Shadow Mode for pilot)
# TODO (Post-Pilot): Enable AIU display once marketing materials are ready
NEXT_PUBLIC_ENABLE_AIU_DISPLAY=false

# ===== EMAIL (SMTP) =====
# Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
# Never commit real credentials — use Replit Secrets or your secrets manager
SMTP_USER=hello@synerxus.com
SMTP_PASSWORD=K!5k3y#n35u$
EMAIL_FROM=hello@synerxus.com

# ===== SECURITY =====
# Required in production — minimum 64 random characters
JWT_SECRET=e7f54dbd3bc7c80f021b9b404d82769a7d0e444ca88b24ab85aa44c6b7840450f489cfeba02b90d06c237a777c0309db
# Must be independent from JWT_SECRET — minimum 64 random characters
REFRESH_TOKEN_SECRET=35aaaf98af91241fa04955333c821e25ca6f3c29976a51f077727d792e051875d0d04cab64375e080715c0c613eb1593
# Comma-separated list of allowed CORS origins (required in production)
CORS_WHITELIST=https://your-app.domain.com
# Full app origin URL — used to lock CSP WebSocket directive to your domain
APP_ORIGIN=https://your-app.domain.com

# ===== FIREBASE CLIENT (required for frontend auth — Vite exposes VITE_* vars to the browser) =====
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

