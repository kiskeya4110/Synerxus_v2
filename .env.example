# ===========================================
# Environment Variables for Volunteer Platform
# ===========================================
# Copy this file to .env and fill in the values
# For Replit: Add these in the "Secrets" tab

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@host:5432/database

# ===== SENTRY ERROR TRACKING =====
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# Format: https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=

# Enable Sentry in development (optional, default: only production)
# SENTRY_ENABLED=true

# ===== UPTIME MONITORING =====
# No configuration needed - endpoints are automatic
# Ping endpoint: /api/ping
# Status endpoint: /api/status

# ===== BACKUPS =====
# Backup output directory (default: ./backups)
# BACKUP_DIR=./backups

# Backup format: json, sql, csv (default: json)
# BACKUP_FORMAT=json

# Enable compression (default: false)
# BACKUP_COMPRESS=true

# Days to keep old backups (default: 7)
# BACKUP_RETENTION_DAYS=7

# ===== FEATURE FLAGS =====
# AIU (Attributable Impact Units) Display
# Set to 'true' to show AIU metrics to users
# Set to 'false' for Shadow Mode (calculations run, UI hidden)
# Default: false (Shadow Mode for pilot)
# TODO (Post-Pilot): Enable AIU display once marketing materials are ready
NEXT_PUBLIC_ENABLE_AIU_DISPLAY=false

# ===== OPTIONAL =====
# NODE_ENV=production
# PORT=5000
# RATE_LIMIT_MAX=1000
