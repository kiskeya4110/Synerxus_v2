# =============================================================================
# Docker Ignore File
# Excludes files from the Docker build context
# =============================================================================

# Dependencies
node_modules
.npm

# Build outputs
dist
.vite

# Development files
.git
.gitignore
.env
.env.*
*.log

# IDE/Editor
.vscode
.idea
*.swp
*.swo
.DS_Store

# Documentation
README.md
CHANGELOG.md
docs/
*.md

# Testing
coverage/
.nyc_output
*.test.ts
*.spec.ts
__tests__

# Docker files (prevent recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Replit specific
.replit
replit.nix
.config
.upm

# Python backend (if exists)
python_backend/
__pycache__/
*.py[cod]
.venv

# Temporary files
tmp/
temp/
*.tmp

# Dummy/Seed data (for production)
dummy/
seed-data.ts

# Certificates and secrets
*.pem
*.key
*.crt
secrets/
